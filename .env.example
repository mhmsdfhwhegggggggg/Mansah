# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mansah"

# NextAuth
NEXTAUTH_SECRET="your-random-secret-key-256-bit"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional - for international payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="منصة - Mansah"
NEXT_PUBLIC_DEFAULT_CURRENCY="YER"
NEXT_PUBLIC_COMMISSION_RATE="0.05"

# Redis (required for BullMQ queue system)
REDIS_URL="redis://localhost:6379"

# S3-Compatible File Storage
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="mansah-uploads"
S3_PUBLIC_URL=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Seed endpoint protection
SEED_SECRET_KEY="your-seed-secret-key"

# Seed user passwords (optional - defaults provided for development)
SEED_ADMIN_PASSWORD="Admin@Mansah2024!"
SEED_AGENT_PASSWORD="Agent@Mansah2024!"
SEED_CUSTOMER_PASSWORD="Customer@Mansah2024!"
