# Database (PostgreSQL - Neon recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-random-secret-key-256-bit"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional - for international payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="منصة - Mansah"
NEXT_PUBLIC_DEFAULT_CURRENCY="YER"
NEXT_PUBLIC_COMMISSION_RATE="0.05"

# Redis (Upstash recommended - use rediss:// for TLS)
REDIS_URL="rediss://default:your-password@your-host.upstash.io:6379"

# S3-Compatible File Storage
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="mansah-uploads"
S3_PUBLIC_URL=""

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"

# Seed endpoint protection
SEED_SECRET_KEY="your-seed-secret-key"

# Seed user passwords (optional - defaults provided for development)
SEED_ADMIN_PASSWORD="Admin@Mansah2024!"
SEED_AGENT_PASSWORD="Agent@Mansah2024!"
SEED_CUSTOMER_PASSWORD="Customer@Mansah2024!"
