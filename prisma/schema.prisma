generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  role          String    @default("CUSTOMER") // CUSTOMER, ADMIN, AGENT
  country       String?
  city          String?
  address       String?
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  payments      Payment[]
  tasks         Task[]     @relation("AgentTasks")
  reviews       Review[]
  cartItems     CartItem[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameAr      String
  slug        String    @unique
  icon        String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id              String    @id @default(cuid())
  title           String
  titleAr         String?
  description     String?
  descriptionAr   String?
  price           Float
  originalPrice   Float
  currency        String    @default("USD")
  images          String    // JSON array of image URLs
  sourceUrl       String    // Original URL on Amazon/AliExpress/Shein
  sourcePlatform  String    // AMAZON, ALIBABA, SHEIN, OTHER
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  inStock         Boolean   @default(true)
  rating          Float?
  reviewCount     Int?
  specifications  String?   // JSON object
  shippingWeight  Float?
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orderItems      OrderItem[]
  cartItems       CartItem[]
  reviews         Review[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  status          String    @default("PENDING") // PENDING, PAYMENT_CONFIRMED, PURCHASING, PURCHASED, SHIPPING, IN_TRANSIT, DELIVERED, CANCELLED, REFUNDED
  totalAmount     Float
  commissionAmount Float
  shippingCost    Float     @default(0)
  currency        String    @default("YER")
  exchangeRate    Float     @default(1)
  shippingAddress String?
  shippingCity    String?
  shippingCountry String?
  shippingPhone   String?
  trackingNumber  String?
  notes           String?
  cancelReason    String?
  estimatedDelivery DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           OrderItem[]
  payments        Payment[]
  tasks           Task[]
  statusHistory   OrderStatus[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  price       Float
  totalPrice  Float
  sourceUrl   String?
  createdAt   DateTime @default(now())
}

model OrderStatus {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amount          Float
  currency        String
  method          String    // BANK_TRANSFER, MOBILE_WALLET, STRIPE, RECEIPT_UPLOAD
  status          String    @default("PENDING") // PENDING, CONFIRMED, REJECTED, REFUNDED
  receiptImage    String?   // For receipt upload
  transactionId   String?   // For payment gateway
  bankName        String?
  accountNumber   String?
  senderName      String?
  notes           String?
  confirmedBy     String?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Task {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  agentId       String?
  agent         User?     @relation("AgentTasks", fields: [agentId], references: [id])
  type          String    // PURCHASE, VERIFY_PRICE, SHIP, DELIVER
  status        String    @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED, FAILED
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  description   String?
  result        String?   // JSON with task result data
  sourcePlatform String?
  purchaseConfirmation String?
  trackingNumber String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ExchangeRate {
  id         String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
